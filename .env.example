# Apify (injected automatically in cloud — only needed for local dev with `apify run`)
APIFY_TOKEN=your_apify_token_here

# Optional: SAM.gov API key (for higher rate limits)
SAM_GOV_API_KEY=your_sam_api_key_here

# Local dev port for Standby HTTP server. In Apify cloud, ACTOR_WEB_SERVER_PORT is injected.
ACTOR_WEB_SERVER_PORT=4321
NODE_ENV=development
